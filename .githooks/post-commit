#!/usr/bin/env bash
# Pushes the branch just committed to. doc_metrics/commit_cost ledger
# logging used to happen here, via a separate auto-generated catch-up
# commit — moved to .githooks/pre-commit instead 2026-09-06, folded
# straight into the commit already being made rather than a follow-up
# commit of its own. See documentation/tooling/DOC_METRICS.md /
# COMMIT_COST.md, and
# documentation/bugs/repo/fixed/2026-09-06-post-commit-catch-up-commit-skips-logging-the-code-commit-it-exists-to-log-SOLVED.md
# for why: the old design's recursion guard, needed to stop the auto-commit
# from re-triggering itself forever, also skipped the one logging call that
# was supposed to close the gap for the *real* commit before it — a
# structural gap on every single use, not an edge case.
#
# Not activated by default — same one-time `git config core.hooksPath
# .githooks` setup as pre-commit.
set -uo pipefail
cd "$(git rev-parse --show-toplevel)"

if ! git symbolic-ref -q HEAD >/dev/null; then
  echo "[post-commit] detached HEAD — skipping push." >&2
  exit 0
fi

BRANCH=$(git rev-parse --abbrev-ref HEAD)
echo "[post-commit] pushing $BRANCH..."
if git rev-parse --abbrev-ref --symbolic-full-name '@{u}' >/dev/null 2>&1; then
  git push origin "$BRANCH" || echo "[post-commit] WARNING: push failed — push manually." >&2
else
  git push -u origin "$BRANCH" || echo "[post-commit] WARNING: push failed — push manually." >&2
fi

exit 0
