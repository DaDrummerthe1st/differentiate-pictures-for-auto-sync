#!/usr/bin/env bash
# Mechanical enforcement of CLAUDE.md's "run the live test suite before every
# commit, docs-only or not" rule — see documentation/bugs/claude-bugs/ for the
# lapse this closes. Repointed from app/tests to modules/tests 2026-09-04 when
# app/, server/, detector/, prototypes/ moved to archive/ on the
# test_production1 branch — see documentation/data-modeling/. The test-suite
# gates below were removed entirely 2026-09-05 when modules/ and contacts/
# were themselves archived to previous-work/ during the native-app pivot
# (documentation/plans/shimmering-wondering-swing.md) — no live product code
# exists at repo root right now, so there is nothing to gate on; re-add a
# gate here once real code (e.g. android/) exists again. Not activated by
# default; see documentation/tooling/README.md for the one-time
# `git config core.hooksPath .githooks` setup.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

# Mechanizes the manual secrets-in-diff scan an AI session used to run by
# hand before every commit (documentation/tooling/TODO.md, raised 2026-07-28).
echo "[pre-commit] running secrets-in-diff scan..."
if ! python3 tools/secrets_scan/run.py; then
  echo "[pre-commit] secrets scan failed — commit blocked. Remove the secret/file, or if it's a known-safe fixture, adjust tools/secrets_scan/scan.py (see CLAUDE.md's --no-verify guidance if this is a false positive you must bypass)." >&2
  exit 1
fi

# Catches a commit_cost/doc_metrics logging gap at the very next commit
# attempt instead of relying on a session remembering to run the wrap-up
# checklist (see documentation/tooling/WRAPUP_CHECKLIST.md's "Scaling"
# section — replaces the retired per-ledger check_coverage.sh scripts).
# Runs before this commit exists, so git log here still ends at the
# *previous* commit, which should already be logged.
echo "[pre-commit] running commit_cost/doc_metrics coverage check..."
if ! python3 tools/wrapup_checklist/run.py --coverage-only; then
  echo "[pre-commit] coverage gap found — commit blocked. Run tools/commit_cost/log.py and/or tools/doc_metrics/log.py to catch up, then retry." >&2
  exit 1
fi
